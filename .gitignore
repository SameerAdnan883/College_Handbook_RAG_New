# =============================================================================
# College Handbook RAG — .gitignore
# =============================================================================

# Secrets — NEVER commit these
.env
*.env

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Virtual environments
venv/
env/
.venv/
ENV/

# Vector stores & indexes (regenerate from PDF)
faiss_index/
chroma_db/

# IDE / editors
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Artifacts that shouldn't be committed to main repo
artifacts/
*.png
*.svg

# Evaluation results (can regenerate; exclude to avoid large diffs)
# data/evaluation_results.csv   # <-- uncomment if you want to exclude

# Logs
*.log
langsmith_traces/
